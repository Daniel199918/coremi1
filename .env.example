# ------------------------------------------------------------------
# Variables d'environnement — modèle
#
# 1. Copier ce fichier :  cp .env.example .env.local
# 2. Remplir les valeurs depuis le dashboard Supabase :
#    https://supabase.com/dashboard/project/_/settings/api
# 3. Sur Vercel : Settings → Environment Variables (mêmes noms).
#
# Ne JAMAIS commiter .env.local — il est ignoré par git.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : aucun secret ici.
# La clé anon/publishable est publique par conception (sécurité via RLS).
# ------------------------------------------------------------------

# URL de l'API du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique (anon / publishable) du projet Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique

# --- Clés serveur (optionnelles, à ajouter seulement si nécessaire) ---
# Clé service_role : accès total, contourne les RLS. UNIQUEMENT côté serveur.
# SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Envoi des demandes de devis par e-mail (voir app/(site)/contact/actions.ts)
# RESEND_API_KEY=votre-cle-resend

# URL canonique du site en production (SEO / sitemap / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://www.coremi.be
